<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="500" author="evgeniyf">
        <preConditions>
            <tableExists schemaName="users" tableName="users"/>
        </preConditions>
        <comment>Error if 'users.users' table is missing; skip if 'data.events' already exists</comment>
    </changeSet>

    <changeSet id="501" author="evgeniyf">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="data" tableName="events"/>
            </not>
        </preConditions>

        <comment>Create table 'data.events' for entity 'Event'</comment>

        <createTable schemaName="data" tableName="events">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_events"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="month_uid" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="work_duration" type="numeric(5)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(500)"/>
        </createTable>

        <createIndex indexName="events_user_id_month_uid_idx" schemaName="data" tableName="events">
            <column name="user_id"/>
            <column name="month_uid"/>
        </createIndex>

        <!-- FK на юзера, короткому принадлежит этот event -->
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="events"
                                 baseTableSchemaName="data"
                                 constraintName="fk_events_on_user"
                                 referencedColumnNames="id"
                                 referencedTableName="users"
                                 referencedTableSchemaName="users"/>

    </changeSet>


</databaseChangeLog>