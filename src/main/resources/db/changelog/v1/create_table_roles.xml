<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="100" author="evgeniyf">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="security" tableName="roles"/>
            </not>
        </preConditions>

        <comment>Create table 'security.roles' for entity 'Role'</comment>

        <sql>
            CREATE TYPE security.role_type AS ENUM ('WORKER','BOSS','CREATOR','MODERATOR');
        </sql>

        <createTable schemaName="security" tableName="roles">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_roles"/>
            </column>
            <column name="role_type" type="security.role_type">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
