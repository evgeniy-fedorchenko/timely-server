<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="503" author="evgeniyf">

        <preConditions>
            <tableExists schemaName="data" tableName="events"/>
        </preConditions>

        <comment>Add column 'changed_at' to table 'data.events'</comment>

        <addColumn schemaName="data" tableName="events">
            <column name="changed_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex indexName="events_user_id_changed_at_idx" schemaName="data" tableName="events">
            <column name="user_id"/>
            <column name="changed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>